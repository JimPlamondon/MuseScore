  description = Building CXX object $out


#############################################
# Rule for compiling Swift files.

rule Swift_COMPILER__MuseScoreQuickLookPreviewExtension_unscanned_Release
  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/swiftc -j 10 -num-threads 10 -c $DEFINES $FLAGS $INCLUDES $in
  description = Building Swift object $out


#############################################
# Rule for emitting Swift .swiftmodule files.

rule Swift_EMIT_MODULE__MuseScoreQuickLookPreviewExtension_Release
  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/swiftc -j 10 -num-threads 10 -emit-module $DEFINES $FLAGS $INCLUDES $in
  description = Emitting Swift .swiftmodule $out
  restat = 1


#############################################
# Rule for linking Swift executable.

rule Swift_EXECUTABLE_LINKER__MuseScoreQuickLookPreviewExtension_Release
  command = $PRE_LINK && /usr/bin/swiftc -j 10 -num-threads 10 -emit-executable -o $TARGET_FILE $FLAGS $in $LINK_FLAGS  $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking Swift executable $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /opt/homebrew/bin/cmake --regenerate-during-build -S/Users/jim/Developer/MeloPresto/Temp/melopresto-score-claude-naming-residue -B/Users/jim/Developer/MeloPresto/Temp/melopresto-score-claude-naming-residue/build.naming
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = /opt/homebrew/bin/cmake -P /Users/jim/Developer/MeloPresto/Temp/melopresto-score-claude-naming-residue/build.naming/CMakeFiles/VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning additional files.

rule CLEAN_ADDITIONAL
  command = /opt/homebrew/bin/cmake -DCONFIG=$CONFIG -P CMakeFiles/clean_additional.cmake
  description = Cleaning additional files...


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /opt/homebrew/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /opt/homebrew/bin/ninja -t targets
  description = All primary targets available:

